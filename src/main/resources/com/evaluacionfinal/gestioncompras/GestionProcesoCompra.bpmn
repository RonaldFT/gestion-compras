    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f9" sourceRef="_ruta" targetRef="_merge1" name="Total hasta 500 UM">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Total hasta 500 UM]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "DIRECTA".equals(solicitud.get("ruta"));]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f10" sourceRef="_ruta" targetRef="_aprobar" name="Total mayor a 500 UM">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Total mayor a 500 UM]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "APROBACION".equals(solicitud.get("ruta"));]]></bpmn2:conditionExpression>
