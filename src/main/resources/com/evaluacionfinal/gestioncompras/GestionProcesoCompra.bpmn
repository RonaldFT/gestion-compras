          <bpmn2:dataInputRefs>_orden_SkippableInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_orden_resumenInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_orden_numeroOrdenOutput</bpmn2:dataOutputRefs>
