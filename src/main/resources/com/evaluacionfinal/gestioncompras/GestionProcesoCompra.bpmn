    <bpmn2:exclusiveGateway id="_merge3" name="Unir resultados" gatewayDirection="Converging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Unir resultados]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f16</bpmn2:incoming><bpmn2:incoming>_f17</bpmn2:incoming><bpmn2:outgoing>_fm3</bpmn2:outgoing></bpmn2:exclusiveGateway><bpmn2:exclusiveGateway id="_merge2" name="Unir rechazos" gatewayDirection="Converging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Unir rechazos]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f8</bpmn2:incoming><bpmn2:incoming>_f14</bpmn2:incoming><bpmn2:outgoing>_fm2</bpmn2:outgoing></bpmn2:exclusiveGateway><bpmn2:exclusiveGateway id="_merge1" name="Unir aprobaciones" gatewayDirection="Converging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Unir aprobaciones]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f9</bpmn2:incoming><bpmn2:incoming>_f13</bpmn2:incoming><bpmn2:outgoing>_fm1</bpmn2:outgoing></bpmn2:exclusiveGateway><bpmn2:scriptTask id="_preparar" name="Preparar consulta" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Preparar consulta]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f2</bpmn2:incoming><bpmn2:outgoing>_f3</bpmn2:outgoing><bpmn2:script><![CDATA[if (email == null || !email.matches("^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$")) {
    throw new IllegalArgumentException("Ingrese un correo valido.");
}
java.util.Map datos = new java.util.HashMap();
datos.put("productoId", productoId);
datos.put("cantidad", cantidad);
datos.put("email", email);
datos.put("motivo", motivo);
datos.put("encontrado", Boolean.FALSE);
datos.put("ruta", "PENDIENTE");
kcontext.setVariable("solicitud", datos);
String base = System.getProperty("compras.catalogo.url", "https://dummyjson.com/products");
kcontext.setVariable("urlProducto", base.replaceAll("/+$", "") + "/" + (productoId == null ? 0 : productoId));]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_rest" name="Consultar producto" drools:taskName="Rest">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Consultar producto]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f3</bpmn2:incoming><bpmn2:outgoing>_f4</bpmn2:outgoing><bpmn2:ioSpecification>
        <bpmn2:dataInput id="_rest_ResultClassInput" name="ResultClass" itemSubjectRef="_String" drools:dtype="java.lang.String"/><bpmn2:dataInput id="_rest_UrlInput" name="Url" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_MethodInput" name="Method" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_AcceptHeaderInput" name="AcceptHeader" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_HandleResponseErrorsInput" name="HandleResponseErrors" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_ConnectTimeoutInput" name="ConnectTimeout" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_ReadTimeoutInput" name="ReadTimeout" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataOutput id="_rest_ResultOutput" name="Result" itemSubjectRef="_Map" drools:dtype="java.util.Map"/>
        <bpmn2:dataOutput id="_rest_StatusOutput" name="Status" itemSubjectRef="_Integer" drools:dtype="java.lang.Integer"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_rest_UrlInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_MethodInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_AcceptHeaderInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_HandleResponseErrorsInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_ConnectTimeoutInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_ReadTimeoutInput</bpmn2:dataInputRefs>
        <bpmn2:dataInputRefs>_rest_ResultClassInput</bpmn2:dataInputRefs></bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_rest_ResultOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_rest_StatusOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>urlProducto</bpmn2:sourceRef>
        <bpmn2:targetRef>_rest_UrlInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_MethodInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">GET</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_MethodInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_AcceptHeaderInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">application/json</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_AcceptHeaderInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_HandleResponseErrorsInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">false</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_HandleResponseErrorsInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_ConnectTimeoutInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">10000</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_ConnectTimeoutInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_ReadTimeoutInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">15000</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_ReadTimeoutInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_rest_ResultOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>respuestaRest</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_rest_StatusOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>estadoHttp</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    <bpmn2:dataInputAssociation><bpmn2:targetRef>_rest_ResultClassInput</bpmn2:targetRef><bpmn2:assignment><bpmn2:from xsi:type="bpmn2:tFormalExpression">java.util.Map</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_ResultClassInput</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation></bpmn2:task>
    <bpmn2:scriptTask id="_leer" name="Procesar respuesta" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Procesar respuesta]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f4</bpmn2:incoming><bpmn2:outgoing>_f5</bpmn2:outgoing><bpmn2:script><![CDATA[if (Integer.valueOf(404).equals(estadoHttp)) {
    solicitud.put("encontrado", Boolean.FALSE);
} else {
    if (estadoHttp == null || estadoHttp < 200 || estadoHttp >= 300) {
        throw new IllegalStateException("Error del catalogo. HTTP " + estadoHttp);
    }
    if (respuestaRest == null || !(respuestaRest.get("id") instanceof Number)
            || productoId == null || ((Number) respuestaRest.get("id")).intValue() != productoId
            || !(respuestaRest.get("title") instanceof String)
            || !(respuestaRest.get("price") instanceof Number)
            || !(respuestaRest.get("stock") instanceof Number)) {
        throw new IllegalStateException("Respuesta invalida del catalogo.");
    }
    java.math.BigDecimal precio = new java.math.BigDecimal(respuestaRest.get("price").toString());
    int stock = ((Number) respuestaRest.get("stock")).intValue();
    if (precio.signum() < 0 || stock < 0) {
        throw new IllegalStateException("Precio o stock invalido.");
    }
    solicitud.put("encontrado", Boolean.TRUE);
    solicitud.put("producto", respuestaRest.get("title"));
    solicitud.put("precio", precio);
    solicitud.put("stock", Integer.valueOf(stock));
    if (cantidad != null) {
        solicitud.put("total", precio.multiply(java.math.BigDecimal.valueOf(cantidad.longValue())).setScale(2, java.math.RoundingMode.HALF_UP));
    }
}
kcontext.getKieRuntime().insert(solicitud);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:businessRuleTask id="_reglas" name="Evaluar compra" drools:ruleFlowGroup="evaluar-compra"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Evaluar compra]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f5</bpmn2:incoming><bpmn2:outgoing>_f6</bpmn2:outgoing></bpmn2:businessRuleTask>
    <bpmn2:scriptTask id="_retirar" name="Preparar resumen" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Preparar resumen]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f6</bpmn2:incoming><bpmn2:outgoing>_f7</bpmn2:outgoing><bpmn2:script><![CDATA[org.kie.api.runtime.rule.FactHandle hecho = kcontext.getKieRuntime().getFactHandle(solicitud);
if (hecho != null) {
    kcontext.getKieRuntime().delete(hecho);
}
String detalle = "Producto: " + solicitud.get("producto") + " | Cantidad: " + solicitud.get("cantidad")
        + " | Total: " + solicitud.get("total") + " UM | Motivo: " + solicitud.get("motivo");
kcontext.setVariable("resumen", detalle);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_ruta" name="Resultado de reglas" gatewayDirection="Diverging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Resultado de reglas]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f7</bpmn2:incoming><bpmn2:outgoing>_f8</bpmn2:outgoing><bpmn2:outgoing>_f9</bpmn2:outgoing><bpmn2:outgoing>_f10</bpmn2:outgoing></bpmn2:exclusiveGateway>
    <bpmn2:userTask id="_aprobar" name="Evaluar solicitud">
