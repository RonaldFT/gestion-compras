          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_orden_TaskNameInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_orden_GroupIdInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">compras</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_orden_GroupIdInput</bpmn2:to>
        </bpmn2:assignment>
