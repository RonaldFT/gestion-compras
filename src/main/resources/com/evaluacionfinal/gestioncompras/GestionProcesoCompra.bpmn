    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f14" sourceRef="_aprobada" targetRef="_merge2" name="No">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[No]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return Boolean.FALSE.equals(aprobada);]]></bpmn2:conditionExpression>
