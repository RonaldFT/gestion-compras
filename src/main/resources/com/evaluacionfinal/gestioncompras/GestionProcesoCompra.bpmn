    <bpmn2:userTask id="_solicitar" name="Registrar solicitud">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Registrar solicitud]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f1</bpmn2:incoming><bpmn2:outgoing>_f2</bpmn2:outgoing><bpmn2:ioSpecification>
        <bpmn2:dataInput id="_solicitar_TaskNameInput" name="TaskName" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
