    <bpmn2:scriptTask id="_registrar" name="Registrar referencia de orden" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Registrar referencia de orden]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f15</bpmn2:incoming><bpmn2:outgoing>_f16</bpmn2:outgoing><bpmn2:script><![CDATA[if (numeroOrden == null || numeroOrden.trim().isEmpty()) {
    throw new IllegalArgumentException("Ingrese el numero de orden.");
}
solicitud.put("resultado", "ORDEN_REGISTRADA");
solicitud.put("detalle", "Orden registrada: " + numeroOrden.trim());]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_rechazo" name="Conservar motivo de rechazo" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Conservar motivo de rechazo]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_fm2</bpmn2:incoming><bpmn2:outgoing>_f17</bpmn2:outgoing><bpmn2:script><![CDATA[if (solicitud.get("resultado") == null) {
    throw new IllegalStateException("Falta el resultado de la solicitud.");
}]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_correoDatos" name="Preparar notificacion" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Preparar notificacion]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_fm3</bpmn2:incoming><bpmn2:outgoing>_f18</bpmn2:outgoing><bpmn2:script><![CDATA[String remitenteCorreo = System.getProperty("compras.correo.remitente", System.getenv("GMAIL_USER"));
if (remitenteCorreo == null || remitenteCorreo.trim().isEmpty()) {
    throw new IllegalStateException("Configure GMAIL_USER en el KIE Server.");
}
String resultado = String.valueOf(solicitud.get("resultado"));
String detalleCorreo = String.valueOf(solicitud.get("detalle")).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
String resumenCorreo = String.valueOf(resumen).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
kcontext.setVariable("remitente", remitenteCorreo);
kcontext.setVariable("asuntoCorreo", "Solicitud de compra - " + resultado);
kcontext.setVariable("cuerpoCorreo", "<h2>Resultado de la solicitud de compra</h2><p>Estado: " + resultado + "</p><p>" + detalleCorreo + "</p><p>" + resumenCorreo + "</p>");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_email" name="Enviar resultado" drools:taskName="Email">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Enviar resultado]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f18</bpmn2:incoming><bpmn2:outgoing>_f19</bpmn2:outgoing><bpmn2:ioSpecification>
        <bpmn2:dataInput id="_email_ToInput" name="To" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_email_FromInput" name="From" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_email_SubjectInput" name="Subject" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_email_BodyInput" name="Body" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_email_ToInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_email_FromInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_email_SubjectInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_email_BodyInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>email</bpmn2:sourceRef>
        <bpmn2:targetRef>_email_ToInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>remitente</bpmn2:sourceRef>
        <bpmn2:targetRef>_email_FromInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>asuntoCorreo</bpmn2:sourceRef>
        <bpmn2:targetRef>_email_SubjectInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>cuerpoCorreo</bpmn2:sourceRef>
        <bpmn2:targetRef>_email_BodyInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>
