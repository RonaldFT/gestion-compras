    <bpmn2:scriptTask id="_decision" name="Validar decision" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Validar decision]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f11</bpmn2:incoming><bpmn2:outgoing>_f12</bpmn2:outgoing><bpmn2:script><![CDATA[if (aprobada == null) {
    throw new IllegalArgumentException("Debe indicar si aprueba la solicitud.");
}
if (!aprobada.booleanValue()) {
    solicitud.put("resultado", "RECHAZADA");
    solicitud.put("detalle", "Solicitud rechazada por el jefe.");
}]]></bpmn2:script>
    </bpmn2:scriptTask>
