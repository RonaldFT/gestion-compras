          <bpmn2:dataInputRefs>_solicitar_productoIdInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_solicitar_cantidadInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_solicitar_emailInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_solicitar_motivoInput</bpmn2:dataInputRefs>
