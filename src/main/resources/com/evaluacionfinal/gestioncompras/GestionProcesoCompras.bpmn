    <bpmn2:scriptTask id="_rechazo" name="Conservar motivo de rechazo" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Conservar motivo de rechazo]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_fm2</bpmn2:incoming><bpmn2:outgoing>_f17</bpmn2:outgoing><bpmn2:script>if (solicitud.getResultado() == null) throw new IllegalStateException("Falta el motivo del rechazo");</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_correoDatos" name="Preparar notificacion" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Preparar notificacion]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_fm3</bpmn2:incoming><bpmn2:outgoing>_f18</bpmn2:outgoing><bpmn2:script>kcontext.setVariable("remitente", System.getenv("GMAIL_USER"));
kcontext.setVariable("asuntoCorreo", "Solicitud de compra - " + solicitud.getResultado());
kcontext.setVariable("cuerpoCorreo", pe.examen.compras.ProcesoCompra.correo(solicitud));</bpmn2:script>
    </bpmn2:scriptTask>
