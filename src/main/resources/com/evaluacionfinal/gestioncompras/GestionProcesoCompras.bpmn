    <bpmn2:exclusiveGateway id="_merge3" name="Unir alternativas" gatewayDirection="Converging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Unir alternativas]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f16</bpmn2:incoming><bpmn2:incoming>_f17</bpmn2:incoming><bpmn2:outgoing>_fm3</bpmn2:outgoing></bpmn2:exclusiveGateway><bpmn2:exclusiveGateway id="_merge2" name="Unir alternativas" gatewayDirection="Converging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Unir alternativas]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f8</bpmn2:incoming><bpmn2:incoming>_f14</bpmn2:incoming><bpmn2:outgoing>_fm2</bpmn2:outgoing></bpmn2:exclusiveGateway><bpmn2:exclusiveGateway id="_merge1" name="Unir alternativas" gatewayDirection="Converging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Unir alternativas]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f9</bpmn2:incoming><bpmn2:incoming>_f13</bpmn2:incoming><bpmn2:outgoing>_fm1</bpmn2:outgoing></bpmn2:exclusiveGateway><bpmn2:scriptTask id="_preparar" name="Preparar consulta" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Preparar consulta]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f2</bpmn2:incoming><bpmn2:outgoing>_f3</bpmn2:outgoing><bpmn2:script>kcontext.setVariable("solicitud", pe.examen.compras.ProcesoCompra.crear(productoId, cantidad, email, motivo));
kcontext.setVariable("urlProducto", pe.examen.compras.ProcesoCompra.url(productoId));</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_rest" name="Consultar producto (REST)" drools:taskName="Rest">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Consultar producto (REST)]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f3</bpmn2:incoming><bpmn2:outgoing>_f4</bpmn2:outgoing><bpmn2:ioSpecification>
        <bpmn2:dataInput id="_rest_UrlInput" name="Url" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_MethodInput" name="Method" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_AcceptHeaderInput" name="AcceptHeader" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_HandleResponseErrorsInput" name="HandleResponseErrors" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_ConnectTimeoutInput" name="ConnectTimeout" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_rest_ReadTimeoutInput" name="ReadTimeout" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataOutput id="_rest_ResultOutput" name="Result" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataOutput id="_rest_StatusOutput" name="Status" itemSubjectRef="_Integer" drools:dtype="java.lang.Integer"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_rest_UrlInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_MethodInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_AcceptHeaderInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_HandleResponseErrorsInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_ConnectTimeoutInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_rest_ReadTimeoutInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_rest_ResultOutput</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_rest_StatusOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>urlProducto</bpmn2:sourceRef>
        <bpmn2:targetRef>_rest_UrlInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_MethodInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">GET</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_MethodInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_AcceptHeaderInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">application/json</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_AcceptHeaderInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_HandleResponseErrorsInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">false</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_HandleResponseErrorsInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_ConnectTimeoutInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">10000</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_ConnectTimeoutInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_rest_ReadTimeoutInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">15000</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_rest_ReadTimeoutInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_rest_ResultOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>respuestaRest</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_rest_StatusOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>estadoHttp</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:scriptTask id="_leer" name="Leer respuesta e insertar hecho" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Leer respuesta e insertar hecho]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f4</bpmn2:incoming><bpmn2:outgoing>_f5</bpmn2:outgoing><bpmn2:script>pe.examen.compras.ProcesoCompra.leerProducto(solicitud, estadoHttp, respuestaRest);
kcontext.getKieRuntime().insert(solicitud);</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:businessRuleTask id="_reglas" name="Evaluar compra (Drools)" drools:ruleFlowGroup="evaluar-compra"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Evaluar compra (Drools)]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f5</bpmn2:incoming><bpmn2:outgoing>_f6</bpmn2:outgoing></bpmn2:businessRuleTask>
    <bpmn2:scriptTask id="_retirar" name="Preparar resultado de reglas" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Preparar resultado de reglas]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f6</bpmn2:incoming><bpmn2:outgoing>_f7</bpmn2:outgoing><bpmn2:script>org.kie.api.runtime.rule.FactHandle fh = kcontext.getKieRuntime().getFactHandle(solicitud);
if (fh != null) kcontext.getKieRuntime().delete(fh);
kcontext.setVariable("resumen", pe.examen.compras.ProcesoCompra.resumen(solicitud));</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_ruta" name="Resultado de reglas" gatewayDirection="Diverging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Resultado de reglas]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f7</bpmn2:incoming><bpmn2:outgoing>_f8</bpmn2:outgoing><bpmn2:outgoing>_f9</bpmn2:outgoing><bpmn2:outgoing>_f10</bpmn2:outgoing></bpmn2:exclusiveGateway>
    <bpmn2:userTask id="_aprobar" name="Evaluar solicitud">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Evaluar solicitud]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f10</bpmn2:incoming><bpmn2:outgoing>_f11</bpmn2:outgoing><bpmn2:ioSpecification>
        <bpmn2:dataInput id="_aprobar_TaskNameInput" name="TaskName" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_aprobar_GroupIdInput" name="GroupId" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_aprobar_SkippableInput" name="Skippable" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataInput id="_aprobar_resumenInput" name="resumen" itemSubjectRef="_String" drools:dtype="java.lang.String"/>
        <bpmn2:dataOutput id="_aprobar_aprobadaOutput" name="aprobada" itemSubjectRef="_Boolean" drools:dtype="java.lang.Boolean"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_aprobar_TaskNameInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_aprobar_GroupIdInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_aprobar_SkippableInput</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_aprobar_resumenInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_aprobar_aprobadaOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_aprobar_TaskNameInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">AprobarSolicitud</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_aprobar_TaskNameInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_aprobar_GroupIdInput</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">jefes</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_aprobar_GroupIdInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
